{
  "name": "meshyard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.7.0",
    "npm": ">=11.19.0"
  },
  "scripts": {
    "check": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && npm run check:frontend && npm run format:check",
    "check:frontend": "tsc --noEmit -p app/tsconfig.json && eslint app/src app/vite.config.ts && vitest run --config app/vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "cd app && tauri dev",
    "build": "cd app && tauri build --debug --bundles app",
    "dev:frontend": "vite --config app/vite.config.ts",
    "build:frontend": "tsc --noEmit -p app/tsconfig.json && vite build --config app/vite.config.ts",
    "icons": "tauri icon assets/scaffold-icon.svg --output app/src-tauri/icons",
    "bindings:generate": "cargo run --offline -p meshyard-core --example export_bindings && prettier --write app/src/ipc/generated"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "vitest": "5.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5"
  }
}
