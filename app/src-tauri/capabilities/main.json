{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local workspace, reviewed hook and explicit Strict P2P actions; event subscription only.",
  "windows": ["main"],
  "permissions": [
    "allow-app-status",
    "allow-create-workspace",
    "allow-update-profile",
    "allow-register-agent",
    "allow-bind-agent",
    "allow-hook-plan",
    "allow-hook-apply",
    "allow-hook-remove",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-network-status",
    "allow-network-start",
    "allow-network-stop",
    "allow-network-invite",
    "allow-network-join",
    "allow-network-confirm"
  ]
}
