{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meshyard",
  "version": "0.2.0",
  "identifier": "ch.arifi.meshyard",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev:frontend",
    "beforeBuildCommand": "npm --prefix .. run build:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Meshyard",
        "width": 960,
        "height": 680,
        "minWidth": 320,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; worker-src 'none'",
      "devCsp": "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; worker-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/meshyard-hook"],
    "macOS": {
      "signingIdentity": "-",
      "infoPlist": "Info.plist",
      "dmg": {
        "background": "../../assets/dmg-background.png",
        "windowSize": {
          "width": 640,
          "height": 440
        },
        "appPosition": {
          "x": 160,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 220
        }
      }
    }
  }
}
